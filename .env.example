# DVLA HR SMS System - Environment Variables Template Example

# mNotify Ghana Enterprise API Gateway
MNOTIFY_API_KEY=your_mnotify_live_api_key_here
MNOTIFY_SENDER_ID=DVLA-HR
MNOTIFY_API_URL=https://api.mnotify.com/api/sms/quick

# Local SQLite Database Path
DATABASE_URL=file:./data/dvla_staff_sms.db

# Optional Local MySQL Database Server
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=dvla_staff_sms

# App Configuration
NEXT_PUBLIC_APP_NAME="DVLA HR Staff Communications System"
